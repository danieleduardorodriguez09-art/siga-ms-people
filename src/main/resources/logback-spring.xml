<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <springProperty name="name" source="spring.application.name"/>

    <springProperty name="lokiUrl" source="logging.loki.url" defaultValue=""/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %magenta(${PID:-}) [%green(${name})] %highlight(%5p) --- [%yellow(%X{traceId:-})][%cyan(%X{spanId:-})] %cyan(%-40.40logger{39}) : %m%n
            </pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- Appender de Loki - solo se define cuando logging.loki.url está configurado -->
    <!-- Para usar Loki, configura logging.loki.url en tu application.yml o Consul -->
    <!-- Por ahora está comentado para desarrollo local -->
