        <format>
            <label>
                <pattern>app:${name},host:${HOSTNAME}</pattern>
                <keyValueSeparator>:</keyValueSeparator>
                <readMarkers>true</readMarkers>
            </label>
            <message>
                <pattern>
                    {
                    "level":"%level",
