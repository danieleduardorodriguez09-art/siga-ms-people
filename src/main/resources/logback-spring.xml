            </message>
            <staticLabels>true</staticLabels>
        </format>
    </appender>
    -->

    <root level="info">
        <appender-ref ref="STDOUT"/>
        <!-- Appender de Loki solo se usa cuando logging.loki.url está configurado -->
        <!-- Para desarrollo local, simplemente no configures logging.loki.url -->
    </root>

</configuration>
